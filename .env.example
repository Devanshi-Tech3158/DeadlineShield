# DeadlineShield Environment Configuration

# Server Port (Render automatically sets PORT)
PORT=3000

# Google Gemini API Key
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (default: gemini-2.5-flash, fallback: gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
